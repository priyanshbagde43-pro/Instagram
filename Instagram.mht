@charset "utf-8";

* { box-sizing: border-box; }

body { margin: 0px; background: rgb(250, 250, 250); color: rgb(17, 17, 17); font-family: Arial, sans-serif; }

button, input, textarea { font: inherit; }

button { cursor: pointer; }

#login { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; background: rgb(255, 255, 255); }

.login { width: 100%; max-width: 350px; text-align: center; }

.logo { font-size: 32px; font-weight: 700; margin-bottom: 28px; }

.login input { width: 100%; height: 45px; margin: 5px 0px; padding: 0px 12px; border: 1px solid rgb(221, 221, 221); border-radius: 8px; background: rgb(250, 250, 250); }

.login button { width: 100%; height: 43px; margin-top: 8px; border: 0px; border-radius: 8px; background: rgb(24, 119, 242); color: white; font-weight: bold; }

.real { font-size: 12px; color: rgb(119, 119, 119); margin-top: 15px; }

#app { display: none; padding-bottom: 62px; }

header { height: 55px; background: white; border-bottom: 1px solid rgb(221, 221, 221); display: flex; align-items: center; padding: 0px 15px; position: sticky; top: 0px; z-index: 10; }

header b { font-size: 22px; }

.page { display: none; max-width: 600px; margin: auto; }

.page.active { display: block; }

.stories { display: flex; gap: 13px; overflow-x: auto; padding: 12px; background: white; border-bottom: 1px solid rgb(221, 221, 221); }

.story { text-align: center; font-size: 11px; min-width: 62px; }

.story img { width: 58px; height: 58px; border-radius: 50%; object-fit: cover; border: 3px solid rgb(214, 41, 118); padding: 2px; }

.post { background: white; margin-bottom: 10px; border-bottom: 1px solid rgb(221, 221, 221); }

.postHead { display: flex; align-items: center; gap: 10px; padding: 10px; }

.avatar { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; }

.click { cursor: pointer; }

.postImg { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; }

.actions { display: flex; gap: 18px; padding: 10px; font-size: 25px; }

.actions span { cursor: pointer; }

.liked { color: red; }

.caption, .comments { padding: 0px 10px 10px; }

.comment { font-size: 13px; margin-top: 6px; }

.commentRow { display: flex; gap: 5px; margin-top: 8px; }

.commentRow input { flex: 1 1 0%; border: 1px solid rgb(221, 221, 221); border-radius: 20px; padding: 8px 12px; }

.commentRow button { border: 0px; background: rgb(24, 119, 242); color: white; border-radius: 20px; padding: 0px 13px; }

.search { padding: 12px; }

.search input { width: 100%; height: 42px; border: 0px; border-radius: 9px; background: rgb(238, 238, 238); padding: 0px 13px; }

.result, .message { display: flex; align-items: center; gap: 12px; background: white; padding: 11px; border-bottom: 1px solid rgb(238, 238, 238); }

.flex { flex: 1 1 0%; }

.small { font-size: 12px; color: rgb(119, 119, 119); }

.follow { border: 0px; border-radius: 7px; padding: 8px 13px; background: rgb(24, 119, 242); color: white; }

.following { background: rgb(221, 221, 221); color: rgb(17, 17, 17); }

.profile { background: white; padding: 18px 12px; }

.profileTop { display: flex; align-items: center; gap: 18px; }

.profilePic { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; }

.stats { flex: 1 1 0%; display: flex; justify-content: space-around; text-align: center; }

.stats b { display: block; font-size: 18px; }

.stats span { font-size: 12px; color: rgb(102, 102, 102); }

.bio { margin-top: 10px; white-space: pre-wrap; }

.edit { background: white; margin-top: 8px; padding: 15px; }

.edit input, .edit textarea { width: 100%; margin-top: 8px; padding: 10px; border: 1px solid rgb(221, 221, 221); border-radius: 8px; }

.edit textarea { min-height: 70px; resize: none; }

.row { display: flex; gap: 5px; margin-top: 8px; }

.row input { width: 33.33%; }

.dark { width: 100%; height: 42px; margin-top: 8px; border: 0px; border-radius: 8px; background: rgb(34, 34, 34); color: white; }

.tabs { display: flex; border-top: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221); margin-top: 15px; }

.tabs button { flex: 1 1 0%; padding: 12px; border: 0px; background: white; }

.gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }

.gallery img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }

.reel { height: calc(-117px + 100vh); min-height: 450px; background: rgb(17, 17, 17); position: relative; overflow: hidden; }

.reel img { width: 100%; height: 100%; object-fit: cover; }

.reelInfo { position: absolute; left: 15px; bottom: 20px; color: white; cursor: pointer; }

.reelBtns { position: absolute; right: 15px; bottom: 25px; display: flex; flex-direction: column; gap: 20px; color: white; font-size: 26px; }

.messages { background: white; min-height: calc(-55px + 100vh); }

.title { font-size: 21px; font-weight: bold; padding: 15px; }

.message { cursor: pointer; margin: 0px; }

.chatHead { height: 55px; background: white; border-bottom: 1px solid rgb(221, 221, 221); display: flex; align-items: center; gap: 10px; padding: 0px 10px; }

.back { border: 0px; background: none; font-size: 25px; }

.chatBody { min-height: calc(-175px + 100vh); padding: 15px 10px 70px; }

.bubble { max-width: 75%; padding: 9px 12px; border-radius: 17px; background: white; margin-bottom: 8px; }

.out { margin-left: auto; background: rgb(24, 119, 242); color: white; }

.chatInput { position: fixed; bottom: 61px; width: 100%; max-width: 600px; background: white; padding: 8px; display: flex; gap: 6px; }

.chatInput input { flex: 1 1 0%; height: 40px; border: 1px solid rgb(221, 221, 221); border-radius: 20px; padding: 0px 12px; }

.chatInput button { width: 65px; border: 0px; border-radius: 20px; background: rgb(24, 119, 242); color: white; }

nav { position: fixed; bottom: 0px; left: 0px; right: 0px; height: 61px; background: white; border-top: 1px solid rgb(221, 221, 221); display: flex; justify-content: space-around; align-items: center; z-index: 20; }

nav button { border: 0px; background: none; font-size: 22px; }

.backBtn { border: 0px; background: none; font-size: 25px; margin-bottom: 8px; }
